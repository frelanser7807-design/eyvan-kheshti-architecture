{
  "name": "world-arch-journal-cinematic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "media:pack": "node scripts/package-media.mjs",
    "media:restore": "node scripts/restore-media.mjs",
    "dev": "node scripts/restore-media.mjs && vite --configLoader runner",
    "build": "node scripts/validate-newsletter.mjs && node scripts/restore-media.mjs && python scripts/build-mineral-materials.py && python scripts/build-mineral-16k.py && vite build --configLoader runner && node scripts/generate-static-pages.mjs && node scripts/generate-newsletter-pdfs.cjs && node scripts/generate-article-pdfs.cjs && node scripts/prune-release.mjs && node scripts/build-newsletter-worker.mjs",
    "wordpress:package": "node scripts/package-wordpress.mjs",
    "preview": "vite preview --configLoader runner",
    "smoke": "node scripts/smoke.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "agent:validate": "node agent-system/scripts/validate-foundation.mjs",
    "agent:test": "node agent-system/scripts/test-workflow.mjs",
    "agent:test:seo": "node agent-system/scripts/test-seo-policy.mjs",
    "agent:test:all": "npm run agent:validate && npm run agent:test && npm run agent:test:magazine && npm run agent:test:seo",
    "agent:test:magazine": "node agent-system/scripts/test-magazine-workflow.mjs",
    "agent:check-sources": "node agent-system/scripts/check-sources.mjs",
    "local-agent:start": "powershell -NoProfile -ExecutionPolicy Bypass -File local-agent/start.ps1",
    "local-agent:test": "node local-agent/test.mjs",
    "materials:mineral": "python scripts/build-mineral-materials.py && python scripts/build-mineral-16k.py"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.2.6",
    "@fontsource/vazirmatn": "^5.2.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "^1.64.0",
    "vite": "^7.1.3"
  }
}
