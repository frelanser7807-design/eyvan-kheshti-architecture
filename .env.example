VITE_DATA_MODE=local
VITE_API_BASE_URL=https://api.example.com
VITE_SITE_URL=https://www.your-domain.com
VITE_ENABLE_LOCAL_ADMIN=false
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=

# Server-only values. Never prefix these with VITE_ and never commit real values.
AGENT_MANAGER_SHARED_SECRET=replace-in-netlify-environment
COMPOSIO_API_KEY=replace-in-netlify-environment
COMPOSIO_USER_ID=replace-in-netlify-environment
# Free/personal NotebookLM uses the Drive handoff. Full Composio automation requires NotebookLM Enterprise custom OAuth.
NOTEBOOKLM_MODE=google_drive_manual_handoff
GEMINI_API_KEY=replace-in-netlify-environment
GEMINI_MODEL=set-an-available-model-id
OPENAI_API_KEY=replace-in-netlify-environment
OPENAI_MODEL=set-an-available-model-id
OPENAI_IMAGE_MODEL=gpt-image-2
ANTHROPIC_API_KEY=replace-in-netlify-environment
ANTHROPIC_MODEL=claude-sonnet-4-6
WORDPRESS_BASE_URL=https://cms.your-domain.com
WORDPRESS_USERNAME=editor-account
WORDPRESS_APPLICATION_PASSWORD=replace-in-server-environment
